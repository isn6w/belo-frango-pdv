# Configuração para Render.com
PORT=3000
NODE_ENV=production
RENDER=true

# Autenticação (obrigatório)
SESSION_SECRET=generate-secure-random-string-here-min-32-chars-REQUIRED

# Database: PostgreSQL via Neon
# Configure via painel Render: Dashboard > Services > belo-frango-pdv > Environment
DATABASE_URL=postgresql://user:password@host:5432/belo_frango